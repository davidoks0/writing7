{
  "builder_seed": 42,
  "training_backend": "transformer",
  "corpus_root": "/corpus",
  "artifacts_root": "/artifacts",
  "split_path": "/corpus/splits/scorer_train_v1.json",
  "calibration_split_path": "/corpus/splits/scorer_calibration_v1.json",
  "base_encoder": "roberta-large",
  "text_view": "style_masked_v1",
  "score_text_views": ["raw", "style_masked_v1"],
  "blend_weights": {
    "raw": 0.35,
    "style_masked_v1": 0.65
  },
  "pooling": "attn",
  "use_projection": true,
  "projection_dim": 1024,
  "contrastive_mode": "supcon",
  "use_topic_adversary": true,
  "semantic_adversary_model": "sentence-transformers/all-MiniLM-L6-v2",
  "content_cluster_count": 16,
  "adv_lambda": 0.7,
  "supcon_temperature": 0.07,
  "max_length": 384,
  "chunk_size_words": 160,
  "chunk_overlap_words": 48,
  "chunk_aggregation": "topk_mean",
  "chunk_top_k": 3,
  "epochs": 6,
  "batch_size_per_device": 24,
  "learning_rate": 2e-05,
  "warmup_steps": 1000,
  "gradient_accumulation": 2,
  "early_stopping_patience": 3,
  "max_features": 2048,
  "hashing_dim": 512
}
